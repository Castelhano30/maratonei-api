// Schema do Maratonei. Convenções: models em PascalCase singular, tabelas e
// colunas em snake_case via @@map/@map, IDs UUIDv7, datas em UTC.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identidade (módulo `auth`, AD-6/AD-8). Escrito à mão seguindo o schema do
// Better Auth 1.7; conferido com a CLI na Fase 1a (campos idênticos), com o unique
// `(provider_id, account_id)` acrescentado por migration aditiva.
// ---------------------------------------------------------------------------

model User {
  id             String       @id @default(uuid(7)) @db.Uuid
  name           String
  email          String       @unique
  emailVerified  Boolean      @default(false) @map("email_verified")
  image          String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions       Session[]
  accounts       Account[]
  ownedLists     List[]
  memberships    ListMember[]
  invitesCreated Invite[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  // Para `credential`, o próprio id do usuário; para o Google, o `sub`.
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  // Hash argon2id da senha (só `credential`). Nunca exposto pela API.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

// Tokens de verificação de e-mail e de reset de senha.
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Listas, membros e convites (módulos `lists` e `invites`, AD-7/AD-9).
// Índices únicos parciais (um OWNER por lista; um convite ativo por lista)
// vivem só na migration: o Prisma não os expressa.
// ---------------------------------------------------------------------------

enum ListRole {
  OWNER
  EDITOR
  MEMBER

  @@map("list_role")
}

model List {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String
  description String?
  // Imutável após a criação (sem transferência de posse no MVP).
  ownerId     String       @map("owner_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     ListMember[]
  invites     Invite[]

  @@index([ownerId])
  @@map("list")
}

model ListMember {
  id       String   @id @default(uuid(7)) @db.Uuid
  listId   String   @map("list_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     ListRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  list     List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([userId])
  @@map("list_member")
}

model Invite {
  id          String    @id @default(uuid(7)) @db.Uuid
  listId      String    @map("list_id") @db.Uuid
  // 32 bytes aleatórios em base64url; a capacidade de entrar na lista.
  token       String    @unique
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  list        List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([listId])
  @@map("invite")
}

# Copie para `.env` e ajuste. Todas as variáveis são validadas por Zod no boot (src/config.ts).

# development | test | production
NODE_ENV=development
# Porta HTTP da API
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Conexão usada pela API (em produção, a URL com pooler do Neon)
DATABASE_URL=postgresql://maratonei:maratonei@localhost:5432/maratonei
# Conexão direta, sem pooler, usada só pelo CLI do Prisma (migrate). Opcional:
# sem ela o CLI usa DATABASE_URL.
# DIRECT_DATABASE_URL=

# Origens aceitas em mutações (verificação de Origin / CSRF), separadas por vírgula.
# Inclua a origem da própria API para o "try it out" do /docs.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Senha do usuário verificado criado pelo seed (só dev/E2E; padrão maratonei-e2e-123)
# SEED_E2E_PASSWORD=
# Senha das contas de teste ana/bruno/carla@maratonei.local (padrão maratonei-teste-123)
# SEED_TEST_PASSWORD=

# Origem pública do web: base dos links de e-mail e baseURL do Better Auth (sem path)
WEB_ORIGIN=http://localhost:3000
# Segredo do Better Auth (mín. 32 caracteres). Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres
# Transporte de e-mail: console (loga o e-mail; Resend entra na Fase 0b)
EMAIL_TRANSPORT=console

# Login com Google (opcional). Sem as duas variáveis o provedor fica desligado.
# Console do Google: URI de redirecionamento autorizado = {WEB_ORIGIN}/api/v1/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Teto técnico de membros por lista (padrão 100)
# MAX_LIST_MEMBERS=100

# Limites por IP/minuto (0 desliga; desligado nos testes) e saltos de proxy confiáveis
# RATE_LIMIT_GLOBAL_PER_MIN=300
# RATE_LIMIT_TITLES_PER_MIN=60
# RATE_LIMIT_AUTH_PER_MIN=30
# Limite público por IP/minuto (padrão 120; 0 desliga)
# RATE_LIMIT_PUBLIC_PER_MIN=120
# Limite público global por minuto (padrão 600; 0 desliga)
# RATE_LIMIT_PUBLIC_GLOBAL_PER_MIN=600
# Mínimo de votos do TMDB no ranking de filmes (padrão 3000)
# CATALOG_MIN_VOTES_MOVIE=3000
# Mínimo de votos do TMDB no ranking de séries (padrão 2000)
# CATALOG_MIN_VOTES_TV=2000
# Log temporário de IP na liveness para medição (padrão false; aceita true/false/1/0)
# LOG_CLIENT_IP_DEBUG=false
# TRUST_PROXY=0

# Pool do Postgres (ms)
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=15000

# Chave da API v3 do TMDB (opcional). Sem ela, busca e detalhe de títulos respondem 503 TMDB_UNAVAILABLE.
# TMDB_API_KEY=
# Só para apontar a um TMDB fake (padrão: https://api.themoviedb.org/3)
# TMDB_BASE_URL=

{
  "name": "maratonei-api",
  "version": "0.1.0",
  "private": true,
  "description": "API do Maratonei: listas compartilhadas de filmes e séries",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "~9.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "~0.45.1",
    "better-auth": "~1.7.7",
    "dotenv": "^18.0.6",
    "express": "~5.2.1",
    "helmet": "~8.3.0",
    "pino": "~10.4.0",
    "pino-http": "~11.0.0",
    "swagger-ui-express": "~5.0.1",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "~24.19.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "supertest": "~7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "~5.0.3"
  }
}
